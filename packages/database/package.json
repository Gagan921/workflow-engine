{
  "name": "@workflow/database",
  "version": "1.0.0",
  "description": "Database schema and Prisma client for workflow engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc",
